{
  "manifest_version": 3,
  "name": "Origin Lens — DigiKey & Mouser",
  "description": "Compare component origin reports on DigiKey and Mouser, with local OCR of LCSC package photos. Exact part matching.",
  "version": "0.10.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": ["storage", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://www.digikey.com/*",
    "https://www.mouser.com/*",
    "https://eu.mouser.com/*",
    "https://api.mouser.com/*",
    "https://www.microchip.com/*",
    "https://www.st.com/*",
    "https://ksmk.st.com/*",
    "https://www.lcsc.com/*",
    "https://assets.lcsc.com/*",
    "https://www.infineon.com/*",
    "https://infineontechnologiesproduction6kx2o63f.org.coveo.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Origin Lens settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": [
      "https://www.digikey.com/en/products/detail/*",
      "https://www.mouser.com/ProductDetail/*",
      "https://www.mouser.com/en/ProductDetail/*",
      "https://eu.mouser.com/ProductDetail/*",
      "https://eu.mouser.com/en/ProductDetail/*"
    ],
    "js": ["ocr.js", "core.js", "st-options.js", "content.js"],
    "run_at": "document_idle"
  }]
}
